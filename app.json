{
  "expo": {
    "name": "EcoScan",
    "slug": "ecoscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecoscan",
    "backgroundColor": "#04110a",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "EcoScan cần quyền truy cập camera để nhận diện rác trực tiếp trên thiết bị. Hình ảnh không được tải lên bất kỳ đâu."
      }
    },
    "android": {
      "package": "com.ecoscan.app",
      "adaptiveIcon": {
        "backgroundColor": "#04110a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "EcoScan cần quyền camera để nhận diện rác trên thiết bị. Ảnh không được gửi ra ngoài.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2e27d87-7029-4160-bc2a-0650daccb93d"
      }
    },
    "owner": "sointerestinggg"
  }
}
